<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>armbot_ur5</name>
  <version>0.0.0</version>
  <description>Armbot_UR5 autonomous pick-and-place controller for a UR5 arm with a Robotiq gripper in ROS 2 and Gazebo.</description>
  <maintainer email="azerbenali5017@gmail.com">Azer Ben Ali</maintainer>
  <author>Azer Ben Ali</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager</depend>
  <depend>cv_bridge</depend>
  <depend>geometry_msgs</depend>
  <depend>gz_ros2_control</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>python3-yaml</depend>
  <depend>rclpy</depend>
  <depend>robotiq_description</depend>
  <depend>ros_gz_bridge</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ur_description</depend>
  <depend>ur_moveit_config</depend>
  <depend>ur_simulation_gz</depend>
  <depend>xacro</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
